AMADEUS_CLIENT_ID=여기에_테스트_API_KEY
AMADEUS_CLIENT_SECRET=여기에_테스트_API_SECRET

# 한국공항공사_실시간 항공기 운항정보 검색_GW (설정 예시, 아직 미연동)
# https://www.data.go.kr/data/15160195/openapi.do
# 출도착 시각/지연/결항 정보용이며 항공권 운임은 제공하지 않습니다.
# 실제 값은 .env에 입력하세요. .env.example에는 인증키를 넣지 마세요.
# URLSearchParams를 사용할 경우 Decoding 인증키를 넣어 한 번만 URL 인코딩합니다.
DATA_GO_KR_SERVICE_KEY=YOUR_DECODED_SERVICE_KEY
# 아래 주소/기능 경로는 활용신청 후 해당 API 활용가이드에서 확인해 교체합니다.
KAC_REALTIME_FLIGHT_BASE_URL=REPLACE_WITH_BASE_URL_FROM_API_GUIDE
KAC_REALTIME_FLIGHT_SEARCH_PATH=REPLACE_WITH_SEARCH_OPERATION_PATH

# 숙소 검색(Claude API) - 서버에서만 사용됩니다. 키가 없으면 샘플 데이터가 표시됩니다.
ANTHROPIC_API_KEY=여기에_ANTHROPIC_API_KEY
# STAY_SEARCH_MODEL=claude-opus-5-5
